      <key>settings</key><dict><key>foreground</key><string>#89DDFF</string></dict>
    </dict>

    <dict>
      <key>name</key><string>Strings</string>
      <key>scope</key><string>string, string.quoted, punctuation.definition.string</string>
      <key>settings</key><dict><key>foreground</key><string>#9ECE6A</string></dict>
