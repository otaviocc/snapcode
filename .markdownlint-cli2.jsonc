{
  // This repo's markdown wraps prose at ~80 chars, not markdownlint's default,
  // and the flag tables in the README run long. Match actual practice instead
  // of reflowing every doc.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false
    }
  }
}
